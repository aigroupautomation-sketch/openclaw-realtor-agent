{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Realtor Agent",
            "type": "shell",
            "command": "node core/src/index.js",
            "options": {
                "env": {
                    "ENV_PATH": "${workspaceFolder}/secrets/.env"
                }
            },
            "group": "test",
            "presentation": { "reveal": "always", "panel": "dedicated" }
        },
        {
            "label": "Start ngrok (Tunnel)",
            "type": "shell",
            "command": "ngrok http 4000",
            "presentation": { "reveal": "always", "panel": "dedicated" }
        }
    ]
}
